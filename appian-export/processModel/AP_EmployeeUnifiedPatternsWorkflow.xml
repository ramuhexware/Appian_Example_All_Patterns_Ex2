<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<processModelObject xmlns:a="http://www.appian.com/ae/types/2009" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <processModel name="AP_EmployeeUnifiedPatternsWorkflow" uuid="c1234567-1234-abcd-abcd-1234567890ab">
    <a:uuid>c1234567-1234-abcd-abcd-1234567890ab</a:uuid>
    <a:name>AP_EmployeeUnifiedPatternsWorkflow</a:name>
    <a:description>Unified Process Model for Employee Management utilizing Custom Smart Services, Expression Functions, REST, SOAP, Servlets, and Struts 2 actions.</a:description>
    <a:processVariables>
      <a:processVariable name="employee" type="tns:Employee" xmlns:tns="urn:com:appian:types:Employee">
        <a:description>Data of the current employee record</a:description>
        <a:isParameter>true</a:isParameter>
      </a:processVariable>
      <a:processVariable name="employeeId" type="xsd:long"/>
      <a:processVariable name="evaluationStatus" type="xsd:string"/>
      <a:processVariable name="evaluationNotes" type="xsd:string"/>
      <a:processVariable name="bonusAmount" type="xsd:double"/>
    </a:processVariables>
    <a:nodes>
      <!-- START EVENT -->
      <a:node id="0" name="Start Event" type="start">
        <a:transitions>
          <a:transition to="1"/>
        </a:transitions>
      </a:node>

      <!-- EXPRESSION FUNCTION SCRIPT TASK -->
      <a:node id="1" name="Calculate Employee Bonus & Validate SSN" type="scriptTask">
        <a:description>Uses Custom Expression Functions fn!calculateEmployeeBonus and fn!validateEmployeeSSN loaded via our custom Plugin JAR</a:description>
        <a:inputs>
          <a:input name="bonusAmount" value="fn!calculateEmployeeBonus(pv!employee.salary, 10.0)"/>
          <a:input name="isValidSSN" value="fn!validateEmployeeSSN(pv!employee.ssn)"/>
        </a:inputs>
        <a:outputs>
          <a:output name="bonusAmount" target="pv!bonusAmount"/>
        </a:outputs>
        <a:transitions>
          <a:transition to="2"/>
        </a:transitions>
      </a:node>

      <!-- CUSTOM SMART SERVICE NODE -->
      <a:node id="2" name="Employee Audit Logger Smart Service" type="customSmartService">
        <a:class>com.appian.enterprise.employee.plugin.smartservice.EmployeeAuditLoggerSmartService</a:class>
        <a:inputs>
          <a:input name="Employee Name" value="concat(pv!employee.firstName, &quot; &quot;, pv!employee.lastName)"/>
          <a:input name="Email" value="pv!employee.email"/>
          <a:input name="Department" value="pv!employee.department"/>
          <a:input name="Base Salary" value="pv!employee.salary"/>
        </a:inputs>
        <a:outputs>
          <a:output name="Employee ID" target="pv!employeeId"/>
          <a:output name="Audit Status" target="pv!evaluationStatus"/>
          <a:output name="Audit Notes" target="pv!evaluationNotes"/>
        </a:outputs>
        <a:transitions>
          <a:transition to="3"/>
        </a:transitions>
      </a:node>

      <!-- ROUTING GATEWAY -->
      <a:node id="3" name="Integration Routing Gateway" type="xor">
        <a:rules>
          <a:rule expression="pv!evaluationStatus = &quot;APPROVED&quot;" transitionTo="4"/>
          <a:rule expression="pv!evaluationStatus = &quot;STRUTS_LOG&quot;" transitionTo="5"/>
          <a:rule expression="pv!evaluationStatus = &quot;SOAP_EVAL&quot;" transitionTo="8"/>
          <a:rule expression="pv!evaluationStatus = &quot;JMS_EVENT&quot;" transitionTo="9"/>
          <a:rule expression="true" transitionTo="6"/>
        </a:rules>
      </a:node>

      <!-- SUBMIT TO REST INTEGRATION -->
      <a:node id="4" name="Persist via REST Web API" type="integration">
        <a:integrationUuid>e4db3fe1-35b8-4d51-9689-a9a7a9de5641</a:integrationUuid>
        <a:inputs>
          <a:input name="employee" value="pv!employee"/>
        </a:inputs>
        <a:transitions>
          <a:transition to="7"/>
        </a:transitions>
      </a:node>

      <!-- SUBMIT TO STRUTS ACTION INTEGRATION -->
      <a:node id="5" name="Log via Struts 2 MVC Action" type="integration">
        <a:integrationUuid>f5bc7a3f-1234-abcd-abcd-9876543210ab</a:integrationUuid>
        <a:inputs>
          <a:input name="employee" value="pv!employee"/>
        </a:inputs>
        <a:transitions>
          <a:transition to="7"/>
        </a:transitions>
      </a:node>

      <!-- SUBMIT TO EMPLOYEE EXPORT SERVLET -->
      <a:node id="6" name="Trigger Employee Export Servlet" type="integration">
        <a:integrationUuid>d19c8f0f-8c31-4a5f-9e12-d2a9a8be5678</a:integrationUuid>
        <a:inputs>
          <a:input name="department" value="pv!employee.department"/>
        </a:inputs>
        <a:transitions>
          <a:transition to="7"/>
        </a:transitions>
      </a:node>

      <!-- SUBMIT TO SOAP INTEGRATION -->
      <a:node id="8" name="Persist via SOAP Web Service" type="integration">
        <a:integrationUuid>e4db3fe1-35b8-4d51-9689-a9a7a9de5642</a:integrationUuid>
        <a:inputs>
          <a:input name="employee" value="pv!employee"/>
        </a:inputs>
        <a:transitions>
          <a:transition to="7"/>
        </a:transitions>
      </a:node>

      <!-- PUBLISH TO JMS QUEUE (Appian JMS / messaging plugin pattern) -->
      <a:node id="9" name="Publish Employee Event to JMS Queue" type="jms_publish">
        <a:destinationName>employee.events.queue</a:destinationName>
        <a:messageBody>a!toJson(pv!employee)</a:messageBody>
        <a:transitions>
          <a:transition to="7"/>
        </a:transitions>
      </a:node>

      <!-- END EVENT -->
      <a:node id="7" name="End Event" type="end"/>
    </a:nodes>
    <a:roleMap>
      <a:role name="Administrator"/>
      <a:role name="Initiator"/>
    </a:roleMap>
  </processModel>
</processModelObject>
