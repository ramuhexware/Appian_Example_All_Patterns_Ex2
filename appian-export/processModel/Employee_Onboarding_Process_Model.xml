<?xml version="1.0" encoding="UTF-8"?>
<process-model-portal name="Employee Onboarding & Verification Process" uuid="0001e8a2-7b19-8000-9a3b-014d52000000">
  <meta>
    <display-name>Employee Onboarding Process</display-name>
    <description>Executes automated background checks via REST, logs audit events via custom Plug-in Smart Service, sends SOAP updates, and emits JMS completion events.</description>
  </meta>
  
  <nodes>
    <node id="0" name="Start Node">
      <type>START_EVENT</type>
    </node>
    
    <node id="1" name="Call External REST Integration (Background Check)">
      <type>INTEGRATION_NODE</type>
      <connected-system-uuid">cs-hr-backend-001</connected-system-uuid>
      <integration-uuid">int-bgcheck-001</integration-uuid>
    </node>
    
    <node id="2" name="Execute Smart Service: Employee Audit Logger">
      <type>CUSTOM_SMART_SERVICE</type>
      <plugin-key>com.appian.enterprise.employee.plugin</plugin-key>
      <smart-service-key>EmployeeAuditLoggerSmartService</smart-service-key>
    </node>

    <node id="3" name="Manager Approval User Task">
      <type>USER_TASK</type>
      <form-uuid>form-emp-approval-001</form-uuid>
    </node>
    
    <node id="4" name="Publish Completion Event to JMS Queue">
      <type>JMS_PUBLISHER</type>
      <destination-queue>employee.events.queue</destination-queue>
    </node>
    
    <node id="5" name="End Node">
      <type>END_EVENT</type>
    </node>
  </nodes>
</process-model-portal>
