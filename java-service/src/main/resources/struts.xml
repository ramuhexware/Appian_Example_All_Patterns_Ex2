<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
    "https://struts.apache.org/dtds/struts-6.0.dtd">

<struts>
    <constant name="struts.devMode" value="true" />
    <constant name="struts.enable.DynamicMethodInvocation" value="true" />

    <package name="default" extends="struts-default" namespace="/">
        
        <!-- Default Struts 2 Action for Employee Management -->
        <action name="employeeStruts" class="com.appian.enterprise.employee.struts.EmployeeStrutsAction" method="execute">
            <result name="success">/WEB-INF/jsp/employee-struts-list.jsp</result>
        </action>

        <!-- Save Employee Action -->
        <action name="saveEmployeeStruts" class="com.appian.enterprise.employee.struts.EmployeeStrutsAction" method="saveEmployee">
            <result name="success">/WEB-INF/jsp/employee-struts-list.jsp</result>
            <result name="input">/WEB-INF/jsp/employee-struts-form.jsp</result>
        </action>

        <!-- Delete Employee Action -->
        <action name="deleteEmployeeStruts" class="com.appian.enterprise.employee.struts.EmployeeStrutsAction" method="deleteEmployee">
            <result name="success">/WEB-INF/jsp/employee-struts-list.jsp</result>
        </action>

    </package>
</struts>
